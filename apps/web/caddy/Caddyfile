{
	servers {
		trusted_proxies static private_ranges
	}
}

:3000 {
	root * /usr/share/caddy/html

	# No rate_limit here: this service only serves the SPA/static chunks.
	# A single login can pull hundreds of /assets/*.js files; limiting them
	# causes false 429s. API / auth / DB abuse is throttled in Django instead
	# (AUTHENTICATION_RATE_LIMIT, API_KEY_RATE_LIMIT, USER_RATE_LIMIT, anon).

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
